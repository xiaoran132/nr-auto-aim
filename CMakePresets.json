{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (MSVC x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "OpenCV_DIR": "C:/dev/opencv/install_ov/lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    }
  ]
}
